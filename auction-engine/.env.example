DATABASE_URL=postgresql://admin:secret@localhost:5432/takelow_db
REDIS_URL=redis://localhost:6379
JWT_SECRET=<must-match-identity-service-JWT_SECRET>
INTERNAL_API_KEY=<must-match-identity-service-INTERNAL_API_KEY>
PORT=3000

# SikinaPay Payment Gateway
# Get your keys at https://dashboard.sikinapay.com/developers
SIKINA_SECRET_KEY=your_live_key_here
SIKINA_WEBHOOK_SECRET=your_webhook_secret_here
SIKINA_BASE_URL=https://api.sikinapay.com
SIKINA_SUCCESS_REDIRECT_URL=https://your-app.com/?payment=success
SIKINA_FAILED_REDIRECT_URL=https://your-app.com/?payment=failed
SIKINA_WEBHOOK_URL=https://your-app.com/api/v1/payments/webhook/sikina
APP_BASE_URL=https://your-app.com
