{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "strict": true,
    "paths": {
      "@/*": [
        "./src/*"
      ],
      "@takelow/api": [
        "../packages/takelow-api/src/index.ts"
      ],
      "@takelow/api/*": [
        "../packages/takelow-api/src/*"
      ]
    }
  },
  "include": [
    "App.tsx",
    "src"
  ],
  "exclude": [
    ".expo",
    "dist",
    "node_modules",
    "android",
    "ios"
  ]
}
